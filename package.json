{
  "name": "token-create-bot",
  "version": "1.0.0",
  "description": "Automated token creation bot for Monad",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "create-tokens": "tsx src/index.ts",
    "create-tokens:watch": "nodemon --exec tsx src/index.ts",
    "prepare-metadata": "tsx src/scripts/prepare-metadata.ts",
    "show-wallets:create": "tsx src/scripts/show-wallets.ts create",
    "show-wallets:volume": "tsx src/scripts/show-wallets.ts volume",
    "fund-wallets:create": "tsx src/scripts/fund-wallets.ts create",
    "fund-wallets:volume": "tsx src/scripts/fund-wallets.ts volume",
    "withdraw-funds:create": "tsx src/scripts/withdraw-funds.ts create",
    "withdraw-funds:volume": "tsx src/scripts/withdraw-funds.ts volume",
    "withdraw-master": "tsx src/scripts/withdraw-master.ts",
    "daily-run": "tsx src/scripts/daily-run.ts",
    "cron": "tsx src/scripts/cron-run.ts",
    "cron:peak": "tsx src/scripts/cron-peak.ts",
    "cron:low": "tsx src/scripts/cron-low.ts",
    "cron:simple-volume": "tsx src/scripts/cron-simple-volume.ts",
    "fetch-eligible-tokens": "tsx src/scripts/fetch-eligible-tokens.ts",
    "test-price": "tsx src/scripts/test-price.ts",
    "start:prepare-metadata": "node dist/scripts/prepare-metadata.js",
    "start:show-wallets:create": "node dist/scripts/show-wallets.js create",
    "start:show-wallets:volume": "node dist/scripts/show-wallets.js volume",
    "start:fund-wallets:create": "node dist/scripts/fund-wallets.js create",
    "start:fund-wallets:volume": "node dist/scripts/fund-wallets.js volume",
    "start:withdraw-funds:create": "node dist/scripts/withdraw-funds.js create",
    "start:withdraw-funds:volume": "node dist/scripts/withdraw-funds.js volume",
    "start:withdraw-master": "node dist/scripts/withdraw-master.js"
  },
  "keywords": ["monad", "token", "automation", "bot"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "viem": "^2.21.0",
    "dotenv": "^16.4.5",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "tsx": "^4.7.0",
    "nodemon": "^3.0.3"
  }
}
