# Network Configuration
NETWORK_MODE=mainnet
# NETWORK_MODE=testnet

# Mainnet
MAINNET_RPC_URL=https://your-monad-mainnet-rpc.com
MAINNET_CHAIN_ID=143

# Testnet
TESTNET_RPC_URL=https://monad-testnet.drpc.org
TESTNET_CHAIN_ID=10143

# Wallet Configuration
MNEMONIC=your twelve word mnemonic phrase here for wallet derivation

# Bot Configuration (for create-tokens script)
NUM_WALLETS=50
TOTAL_TOKENS_TO_CREATE=60
DURATION_HOURS=0.3

# Cron Mode Configuration (for Railway)
# MODE: evening or night
# - evening: 21:00-01:00 KST (4 hours, 30 tokens)
# - night: 01:00-16:00 KST (15 hours, 20 tokens)
MODE=evening

# Execution Mode
# - sequential: Create tokens sequentially with evenly-spaced delays (uses DELAY_RANDOMNESS)
# - parallel: Launch all tokens concurrently with fully random delays (ignores DELAY_RANDOMNESS)
EXECUTION_MODE=parallel

# Randomness factor for sequential mode only (0.0 = no randomness, 1.0 = ±100% random)
# Only applies when EXECUTION_MODE=sequential
# Example: If average delay is 1 min and randomness is 0.5, actual delay will be 30s-90s
DELAY_RANDOMNESS=0.5

# Initial Buy Configuration
# Mode: 'fixed' uses INITIAL_BUY_AMOUNT MON, 'dynamic' calculates buy amount from target points
INITIAL_BUY_MODE=dynamic

# Fixed mode: MON amount to buy (ignored if INITIAL_BUY_MODE=dynamic)
INITIAL_BUY_AMOUNT=15

# Dynamic mode: Target POINTS to earn (ignored if INITIAL_BUY_MODE=fixed)
# Point system: $1 fee = 10 points, but Create fee has 0.8x multiplier
# - Create (10 MON): 8 points per $1
# - Buy (1%): 10 points per $1
# - Sell (1%): 10 points per $1
# Example: 220 points for production
TARGET_POINTS=220

SELL_PERCENTAGE=100

# Gas Configuration
GAS_LIMIT=500000
MAX_FEE_PER_GAS=2
MAX_PRIORITY_FEE_PER_GAS=1

# Metadata API
# Token list fetch (always mainnet - more tokens available)
TOKEN_LIST_API_BASE_URL=https://api.nad.fun

# Metadata upload (use network-specific API)
MAINNET_METADATA_API_BASE_URL=https://api.nad.fun
TESTNET_METADATA_API_BASE_URL=https://dev-api.nad.fun

# Metadata fetch settings
METADATA_START_PAGE=1
METADATA_LIMIT_PER_PAGE=100

# Metadata preparation mode
# - upload: Download images from mainnet and re-upload to current network
# - reuse: Reuse existing metadata URIs (not implemented yet)
METADATA_MODE=upload

# Funding (MON amount to send to each wallet)
WALLET_FUNDING_AMOUNT=100

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_MS=5000

# Pyth Oracle Configuration (for dynamic pricing)
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_MON_FEED_ID=0x31491744e2dbf6df7fcf4ac0820d18a609b49076d45066d3568424e62f686cd1
PRICE_CACHE_TTL_SECONDS=60

# Daily Run Configuration
# Interval between runs in hours (0.5 = 30 min, 1 = 1 hour, 24 = once per day)
DAILY_RUN_INTERVAL_HOURS=24
